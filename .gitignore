# Local .terraform directories
**/.terraform/*
.terraform/
**/.terraform/

# .tfstate files
*.tfstate
*.tfstate.*
**/*.tfstate
**/*.tfstate.*

# Crash log files
crash.log
crash.*.log
**/crash.log
**/crash.*.log

# Ignore override files as they are meant for local customization
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI config files
.terraformrc
terraform.rc
